{
  "description": "Example list designs for the AI (T-19, Q-32), in the create_list input format. Generated by test/support/ai_schema_export.dart from the templates (lib/lists/builtin_templates.dart, English labels) and the designs there; regenerate with flutter test --update-goldens.",
  "examples": [
    {
      "id": "tasks",
      "request": "I need a to-do list with categories, dates and repeating tasks",
      "tool": "create_list",
      "input": {
        "list": {
          "name": "Tasks",
          "icon": "pending_actions",
          "color": "#FF4D12",
          "fields": [
            {
              "key": "title",
              "type": "text",
              "required": true,
              "primary": true,
              "label": "Title"
            },
            {
              "key": "description",
              "type": "longText",
              "label": "Description"
            },
            {
              "key": "done",
              "type": "checkbox",
              "role": "completion",
              "label": "Completed"
            },
            {
              "key": "category",
              "type": "category",
              "role": "category",
              "label": "Category"
            },
            {
              "key": "subtasks",
              "type": "checklist",
              "label": "Subtasks"
            },
            {
              "key": "reminderAt",
              "type": "dateTime",
              "role": "reminder",
              "label": "Date"
            },
            {
              "key": "repeat",
              "type": "recurrence",
              "label": "Repeat"
            }
          ],
          "view": {
            "kind": "checklist",
            "filterChipsBy": "category",
            "bucketBy": "reminderAt"
          },
          "behaviors": [
            {
              "kind": "recurOnClear",
              "dateField": "reminderAt",
              "recurrenceField": "repeat"
            },
            {
              "kind": "clearCompleted"
            }
          ]
        }
      }
    },
    {
      "id": "grocery",
      "request": "Make me a shopping list where staples come back next time",
      "tool": "create_list",
      "input": {
        "list": {
          "name": "Grocery",
          "icon": "shopping_cart",
          "color": "#00A63E",
          "fields": [
            {
              "key": "title",
              "type": "text",
              "required": true,
              "primary": true,
              "label": "Title"
            },
            {
              "key": "description",
              "type": "longText",
              "label": "Description"
            },
            {
              "key": "done",
              "type": "checkbox",
              "role": "completion",
              "label": "Completed"
            },
            {
              "key": "section",
              "type": "enum",
              "role": "section",
              "options": [
                {
                  "value": "current",
                  "label": "Current Grocery Run"
                },
                {
                  "value": "nextTime",
                  "label": "Next Time"
                }
              ],
              "default": "current",
              "label": "Section"
            },
            {
              "key": "autoAddToNext",
              "type": "toggle",
              "label": "Repeats to Next Time after clearing"
            }
          ],
          "view": {
            "kind": "sectioned",
            "sectionBy": "section"
          },
          "behaviors": [
            {
              "kind": "copyOnClear",
              "when": "autoAddToNext",
              "where": [
                {
                  "field": "section",
                  "value": "current"
                }
              ],
              "setField": [
                {
                  "field": "section",
                  "value": "nextTime"
                }
              ],
              "dedupeBy": "title"
            },
            {
              "kind": "moveAll",
              "field": "section",
              "from": "nextTime",
              "to": "current"
            },
            {
              "kind": "clearCompleted"
            }
          ]
        }
      }
    },
    {
      "id": "journal",
      "request": "I want to keep a journal",
      "tool": "create_list",
      "input": {
        "list": {
          "name": "Journal",
          "icon": "book",
          "color": "#E5007E",
          "fields": [
            {
              "key": "title",
              "type": "text",
              "required": true,
              "primary": true,
              "label": "Title"
            },
            {
              "key": "body",
              "type": "longText",
              "label": "Entry"
            }
          ],
          "view": {
            "kind": "timeline",
            "dateField": "createdAt",
            "timelineGrouping": "month"
          }
        }
      }
    },
    {
      "id": "watchRead",
      "request": "A list of movies, shows and books I want to watch or read",
      "tool": "create_list",
      "input": {
        "list": {
          "name": "Watch/Read",
          "icon": "movie",
          "color": "#6B3BFF",
          "fields": [
            {
              "key": "title",
              "type": "text",
              "required": true,
              "primary": true,
              "label": "Title"
            },
            {
              "key": "type",
              "type": "enum",
              "options": [
                {
                  "value": "movie",
                  "label": "Movie"
                },
                {
                  "value": "tvShow",
                  "label": "TV Show"
                },
                {
                  "value": "book",
                  "label": "Book"
                }
              ],
              "default": "movie",
              "label": "Type"
            },
            {
              "key": "status",
              "type": "enum",
              "role": "status",
              "options": [
                {
                  "value": "planned",
                  "label": "Planned"
                },
                {
                  "value": "inProgress",
                  "label": "In Progress"
                },
                {
                  "value": "completed",
                  "label": "Completed"
                }
              ],
              "default": "planned",
              "label": "Status"
            },
            {
              "key": "season",
              "type": "counter",
              "min": 0,
              "visibleWhen": {
                "field": "type",
                "in": [
                  "tvShow"
                ]
              },
              "label": "Season"
            },
            {
              "key": "episode",
              "type": "counter",
              "min": 0,
              "visibleWhen": {
                "field": "type",
                "in": [
                  "tvShow"
                ]
              },
              "label": "Episode"
            },
            {
              "key": "notes",
              "type": "longText",
              "label": "Notes"
            }
          ],
          "view": {
            "kind": "grouped",
            "groupBy": "status"
          }
        }
      }
    },
    {

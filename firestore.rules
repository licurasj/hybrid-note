rules_version = '2';

// Q-8 B: each signed-in user reads and writes only their own users/{uid}
// tree, with light shape checks. Reading in the app stays tolerant (a
// malformed document is skipped), so these checks guard against writes that
// are clearly wrong, not against every invalid list.
//
// There are no caps on key or entry counts (T-14 R4): the app accepts any
// number of fields and keeps hidden values, so a cap would make valid lists
// unwritable. Firestore's 1 MiB per document is the only size limit.
//
// The user document users/{uid} is the starter-lists marker (T-17, Q-22 D):
// the owner reads it and creates it once, with `starterSeededAt`; it is
// never changed or deleted from the app, so deleted starter lists do not
// come back.
//
// users/{uid}/settings/preferences holds the account's preferences (Q-48 A).
// The app sets one key at a time and never deletes the document.
//
// List documents carry the store's `_createdAt` (an ISO date string, for the
// list order) and item documents its `_rev` (an int) next to their JSON.
// Arrays inside arrays are stored as {"__array": [...]} maps; the rules do
// not look inside `values`, so that encoding passes as it is.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isId(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    // A list definition (ListDefinition.toJson). Keys written by a newer
    // build are kept by the app, so other keys are allowed.
    function isList(listId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'icon', 'color', 'fields', 'view', 'updatedAt'])
        && isId(data.id) && data.id == listId
        && data.icon is string && data.color is string
        && data.fields is list
        && data.view is map
        && (!('behaviors' in data) || data.behaviors is list)
        && (!('schemaRevision' in data) || data.schemaRevision is int)
        // A description is at most 200 code points, as the app (T-20, Q-56).
        // size() counts UTF-16 units; an RE2 match counts code points.
        && (!('description' in data) || (data.description is string && data.description.matches('(?s).{0,200}')))
        && (!('descriptionKey' in data) || data.descriptionKey == null || data.descriptionKey is string)
        && data.updatedAt is string
        && (!('_createdAt' in data) || data._createdAt is string);
    }

    // An item (ListItem.toJson) plus `_rev`, stored under its own list.
    function isItem(listId, itemId) {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'listId', 'values', 'createdAt', 'updatedAt'])
        && isId(data.id) && data.id == itemId
        && data.listId == listId
        && data.values is map
        && data.createdAt is string && data.updatedAt is string
        && (!('_rev' in data) || data._rev is int);
    }

    // The starter-lists marker. Keys of a newer build are allowed.
    function isMarker() {
      let data = request.resource.data;
      return data.keys().hasAll(['starterSeededAt'])
        && data.starterSeededAt is string;
    }

    // The account's preferences, as light as the others: a choice is a string,
    // since a newer build may add choices. Keys of a newer build are allowed.
    function isPreferences() {
      let data = request.resource.data;
      return (!('listOrder' in data) || data.listOrder is string)
        && (!('myListOrder' in data) || data.myListOrder is list)
        && (!('startScreen' in data) || data.startScreen is string)
        && (!('tickedItems' in data) || data.tickedItems is string)
        && (!('confirmDelete' in data) || data.confirmDelete is bool)
        && (!('showAiBar' in data) || data.showAiBar is bool)
        && (!('aiAutoApply' in data) || data.aiAutoApply is bool)
        && (!('aiAskLevel' in data) || data.aiAskLevel is string)
        && (!('aiAutoApplyOffered' in data) || data.aiAutoApplyOffered is bool)
        && (!('aiNoticeSeen' in data) || data.aiNoticeSeen is string)
        && (!('vibration' in data) || data.vibration is bool)
        && (!('timeFormat' in data) || data.timeFormat is string)
        && (!('weekStart' in data) || data.weekStart is string);
    }

    // aiCommand's server-only documents (T-19): the allowlist, the cap
    // counters and the 7-day prompt log. Only the function (Admin SDK, which
    // bypasses rules) touches them; no client may read or write them. Rules
    // deny anything unmatched anyway; these blocks make it explicit.
    match /aiAllowlist/{doc=**} {
      allow read, write: if false;
    }
    match /aiUsageUser/{doc=**} {
      allow read, write: if false;
    }
    match /aiUsagePool/{doc=**} {
      allow read, write: if false;
    }
    match /aiPromptLog/{doc=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isMarker();
    }

    match /users/{uid}/settings/preferences {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isPreferences();
    }

    match /users/{uid}/lists/{listId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isList(listId);

      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isItem(listId, itemId);
      }
    }
  }
}
